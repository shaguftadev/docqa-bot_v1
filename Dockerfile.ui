FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /ui

COPY frontend ./frontend
COPY reports/evaluation ./reports/evaluation

RUN pip install --no-cache-dir httpx==0.28.1 streamlit==1.67.0

EXPOSE 8501

CMD ["streamlit", "run", "frontend/streamlit_app.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--browser.gatherUsageStats", "false"]
