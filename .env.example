# Copy to .env for local development. Keep real credentials out of Git.
APP_ENV=local
APP_NAME=SupportPilot AI
LOG_LEVEL=INFO

# PostgreSQL connection for host-run development; Compose overrides this for its internal service.
DATABASE_URL=postgresql+psycopg://supportpilot:change-me@localhost:5432/supportpilot

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=supportpilot_documents

# Add a Google AI Studio API key locally to enable grounded answer generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Document processing defaults; refined and validated during the RAG milestone.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
CHUNK_SIZE=800
CHUNK_OVERLAP=120
UPLOAD_MAX_MB=20

# Optional tracing. Do not enable until configured deliberately.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supportpilot-ai
